# ====================================================
# ZenBooking - Environment Variables Configuration
# ====================================================

# --- Server Configuration ---
SERVER_PORT=8080

# --- Database (MySQL) Configuration ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zenbooking
DB_USER=root
DB_PASS=root

# --- Spring Security & JWT ---
# JWT Secret Key: Chuỗi bí mật tối thiểu 256 bits (32 bytes) dùng để ký HMAC-SHA256
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Thời gian hết hạn của JWT token (milliseconds): 86400000 ms = 24 giờ
JWT_EXPIRATION=86400000

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
